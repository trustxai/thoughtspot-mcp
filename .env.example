# ThoughtSpot instance base URL (no trailing /api/rest path)
# e.g. https://my-instance.thoughtspot.cloud
THOUGHTSPOT_HOST=

# Service account username used for token exchange.
THOUGHTSPOT_USERNAME=

# Auth precedence: static token > secret_key (trusted auth) > password.
# Preferred: trusted authentication via secret_key (no password stored, enables RLS impersonation).
# Enable it under Develop > Security Settings in ThoughtSpot.
THOUGHTSPOT_SECRET_KEY=

# Fallback: username + password to /auth/token/full (simplest when trusted auth is off).
THOUGHTSPOT_PASSWORD=

# Optional: skip token exchange entirely by providing a pre-fetched bearer token.
# THOUGHTSPOT_ACCESS_TOKEN=

# Optional: target a specific Org (multi-tenant instances).
# THOUGHTSPOT_ORG_ID=

# Optional: token validity window requested at exchange (default 300s — ThoughtSpot's own default).
# THOUGHTSPOT_TOKEN_VALIDITY_SECONDS=300

# Optional: HTTP request timeout (seconds).
# THOUGHTSPOT_REQUEST_TIMEOUT_SECONDS=30

# Optional: live/destructive pytest settings (see tests/conftest.py)
# THOUGHTSPOT_TEST_ALLOW_DESTRUCTIVE=1
